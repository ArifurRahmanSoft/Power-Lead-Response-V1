LIVE=true
LOCAL_DATABASE_URL=postgresql://username:password@localhost:5432/powerlead_response
PRODUCTION_DATABASE_URL=postgresql://username:password@production-host:5432/powerlead_response
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_PATH=/reset-password
LEAD_IMPORT_MAX_FILE_BYTES=5242880
LEAD_IMPORT_MAX_ROWS=5000
LEAD_IMPORT_RETENTION_HOURS=72

GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_SECONDS=30
LEAD_VOICE_MAX_UPLOAD_BYTES=10485760
LEAD_VOICE_MAX_DURATION_SECONDS=120
LEAD_VOICE_RATE_LIMIT_REQUESTS=10
LEAD_VOICE_RATE_LIMIT_WINDOW_SECONDS=60

# Required to save/use SMTP credentials. Value: one Fernet key (URL-safe
# base64 encoding of exactly 32 random bytes; normally 44 characters).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the real value in the deployment secret manager. Never commit it.
SMTP_CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated prior Fernet keys used only while rotating credentials.
SMTP_CREDENTIAL_PREVIOUS_KEYS=
SMTP_CONNECTION_TIMEOUT_SECONDS=10
SMTP_MAX_CONCURRENT_OPERATIONS=5
SMTP_TEST_EMAIL_RATE_LIMIT_REQUESTS=5
SMTP_TEST_EMAIL_RATE_LIMIT_WINDOW_SECONDS=300

# Persistent S3-compatible object storage for private mail-template assets.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_USE_SSL=true
MAIL_TEMPLATE_ASSET_MAX_FILE_BYTES=10485760
MAIL_TEMPLATE_MAX_ASSETS=20
MAIL_TEMPLATE_MAX_TOTAL_BYTES=26214400

# Durable outbound-mail previews and worker limits.
MAIL_PREVIEW_EXPIRE_MINUTES=15
MAIL_WORKER_POLL_SECONDS=2
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_CONCURRENCY=4
MAIL_WORKER_LEASE_SECONDS=120
MAIL_WORKER_MAX_ATTEMPTS=4
MAIL_WORKER_SENDER_RATE_PER_MINUTE=60
MAIL_WORKER_WORKSPACE_RATE_PER_MINUTE=300
MAIL_MAX_ENCODED_MESSAGE_BYTES=26214400
MAIL_BULK_MAX_SELECTION=500
MAIL_BULK_PREVIEW_PAGE_SIZE=50
# Explicit Lead List sends run synchronously through SMTP and never create
# outbox jobs. Keep this request limit deliberately small.
MAIL_DIRECT_SEND_MAX_RECIPIENTS=10
MAIL_DIRECT_SEND_CONCURRENCY=3
MAIL_DIRECT_SEND_TIMEOUT_SECONDS=30


TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VERIFY_SERVICE_SID=
# Twilio Sandbox/WhatsApp sender. Accepts +E164 or whatsapp:+E164.
TWILIO_WHATSAPP_FROM=
# Public HTTPS origin used to validate webhook signatures and build callbacks,
# for example https://example.ngrok-free.app (no trailing slash).
TWILIO_WHATSAPP_WEBHOOK_BASE_URL=
SMS_DIRECT_SEND_MAX_RECIPIENTS=10
SMS_DIRECT_SEND_CONCURRENCY=3
SMS_DIRECT_SEND_TIMEOUT_SECONDS=20
SMS_STATUS_REFRESH_MIN_SECONDS=30
WHATSAPP_REPLY_MAX_CHARACTERS=1600
WHATSAPP_REPLY_TIMEOUT_SECONDS=20
WHATSAPP_REPLY_RATE_LIMIT_REQUESTS=30
WHATSAPP_REPLY_RATE_LIMIT_WINDOW_SECONDS=60

# Meta WhatsApp Cloud API. Store real values only in local/deployment secrets.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_TIMEOUT_SECONDS=20
META_WHATSAPP_SEND_RATE_LIMIT_REQUESTS=30
META_WHATSAPP_SEND_RATE_LIMIT_WINDOW_SECONDS=60
META_WHATSAPP_TEMPLATE_FETCH_LIMIT=500

# Facebook Page Messenger webhooks. Store real values only in secrets.
META_MESSENGER_VERIFY_TOKEN=
META_MESSENGER_PAGE_ID=
META_MESSENGER_PAGE_ACCESS_TOKEN=
# Leave blank only when Messenger and WhatsApp belong to the same Meta app.
META_MESSENGER_APP_SECRET=
META_MESSENGER_TIMEOUT_SECONDS=20
META_MESSENGER_REPLY_MAX_CHARACTERS=2000
META_MESSENGER_REPLY_RATE_LIMIT_REQUESTS=30
META_MESSENGER_REPLY_RATE_LIMIT_WINDOW_SECONDS=60
META_MESSENGER_PROFILE_CACHE_HOURS=24
META_MESSENGER_PROFILE_RETRY_SECONDS=900
META_MESSENGER_PROFILE_REFRESH_LIMIT=25
META_MESSENGER_PROFILE_REFRESH_CONCURRENCY=4
META_MESSENGER_PROFILE_REFRESH_RATE_LIMIT_REQUESTS=5
META_MESSENGER_PROFILE_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# Instagram API with Unified Login. The token is a Business Integration
# System User Access Token and API calls use graph.facebook.com.
# Unified Login configuration identifier shown in Meta App Dashboard.
META_INSTAGRAM_CONFIG_ID=
# Instagram Professional Account ID assigned to the Unified Login token.
META_INSTAGRAM_ACCOUNT_ID=
# Business Integration System User access token. Keep server-side only.
META_INSTAGRAM_ACCESS_TOKEN=
# Secret value used only for webhook challenge verification.
META_INSTAGRAM_VERIFY_TOKEN=
# Instagram app secret used for exact-body webhook signature validation.
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_TIMEOUT_SECONDS=20
META_INSTAGRAM_REPLY_RATE_LIMIT_REQUESTS=30
META_INSTAGRAM_REPLY_RATE_LIMIT_WINDOW_SECONDS=60
